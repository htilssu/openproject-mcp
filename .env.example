OPENPROJECT_URL=https://project.tgl-cloud.com/
OPENPROJECT_API_TOKEN=11ad0012c5ea8060e99dfc175c12d8aadcd6a08799214a0fe8e765dd17acf4d3
OPENPROJECT_ALLOW_WRITE=true



OPENPROJECT_TIMEOUT_MS=30000
OPENPROJECT_MAX_RETRIES=2
OPENPROJECT_RETRY_BASE_MS=500
OPENPROJECT_MAX_RESPONSE_BYTES=5242880

# Relay for local files when OpenProject direct/S3 upload is unavailable.
# The relay accepts raw bytes and streams them to OpenProject without writing files to disk.
# Enabled by default (local mode): 127.0.0.1, random free port, random per-process secret.
OPENPROJECT_RELAY_ENABLED=true
# Leave HOST/PORT/PUBLIC_BASE_URL/SECRET empty for local mode. For a hosted relay, set them, e.g.:
#   OPENPROJECT_RELAY_HOST=0.0.0.0
#   OPENPROJECT_RELAY_PORT=8788
#   OPENPROJECT_RELAY_PUBLIC_BASE_URL=https://openproject-mcp.example.com  (routes /upload/* to the port)
#   OPENPROJECT_RELAY_SECRET=<random secret >= 32 characters>
OPENPROJECT_RELAY_HOST=
OPENPROJECT_RELAY_PORT=
OPENPROJECT_RELAY_PUBLIC_BASE_URL=
OPENPROJECT_RELAY_SECRET=
OPENPROJECT_RELAY_TOKEN_TTL_SECONDS=300
OPENPROJECT_RELAY_MAX_UPLOAD_BYTES=52428800

# Optional upload from Internet URLs. Empty means disabled.
# Only HTTPS URLs whose host matches this comma-separated allowlist are accepted.
# Wildcards match subdomains only, e.g. cdn.example.com,*.githubusercontent.com
OPENPROJECT_REMOTE_UPLOAD_ALLOWED_HOSTS=
OPENPROJECT_REMOTE_UPLOAD_MAX_BYTES=20971520
OPENPROJECT_REMOTE_UPLOAD_MAX_REDIRECTS=3
