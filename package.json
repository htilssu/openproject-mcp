{
  "name": "@htilssu/openproject-mcp",
  "version": "1.2.0",
  "description": "MCP server for OpenProject API v3",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "openproject-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck",
    "test": "tsx tests/openproject.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
